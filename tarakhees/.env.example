# ══════════════════════════════════════════════════════════════
#  نظام متابعة التراخيص — متغيرات البيئة
#  انسخ هذا الملف إلى .env وعبّئ القيم. لا تُودِع .env في git.
# ══════════════════════════════════════════════════════════════

# ───────────────── قاعدة البيانات ─────────────────
POSTGRES_USER=tarakhees
POSTGRES_PASSWORD=غيّرني
POSTGRES_DB=tarakhees
POSTGRES_PORT=5432
DATABASE_URL="postgresql://tarakhees:غيّرني@localhost:5432/tarakhees?schema=public"

# ───────────────── Redis (طابور التنبيهات) ─────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ───────────────── المنافذ ─────────────────
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ───────────────── المصادقة (المهمة ٣) ─────────────────
# انسخ نمط Argon2id + JWT مع تدوير refresh token من مشروع bedayah2030
JWT_ACCESS_SECRET=غيّرني-سرًا-عشوائيًا-طويلًا
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=غيّرني-سرًا-عشوائيًا-آخر
JWT_REFRESH_TTL=30d

# مشرفو المنصة (فريقك أنت، لا العملاء) — بُرد مفصولة بفواصل.
# يتجاوزون أدوار المستأجر ويصلون إلى مسارات /admin،
# لكنهم لا يتجاوزون عزل البيانات: يرون منشأتهم فقط.
SUPER_ADMIN_EMAILS=

# ───────────────── المجدول ─────────────────
# المجدول يفترض عملية واحدة. عند تشغيل أكثر من نسخة من الـ API،
# فعّله على نسخة واحدة فقط (راجع ملاحظة التوسع في reminders.module.ts)
SCHEDULER_ENABLED=true
APP_TIMEZONE=Asia/Riyadh

# ───────────────── واتساب — Meta Cloud API ─────────────────
# ⚠️ الرسائل المبادِرة تتطلب قالبًا معتمدًا مسبقًا لدى Meta.
#    اسم القالب: license_expiry_notice — وترتيب {{1}}..{{5}}
#    يجب أن يطابق reminder.templates.ts حرفيًا.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ───────────────── البريد ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="نظام التراخيص <no-reply@example.sa>"

# ───────────────── الرسائل النصية ─────────────────
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_NAME=

# ───────────────── تشفير الحقول الحسّاسة ─────────────────
# القاعدة الثابتة رقم ٤: لا يُخزَّن رقم الهوية أو الإقامة بلا تشفير.
# ولّد مفتاحًا (٣٢ بايت base64):  openssl rand -base64 32
# ⚠️ فقدان هذا المفتاح يعني فقدان كل أرقام الهوية المحفوظة — احفظه
#    مع النسخ الاحتياطية في مكان منفصل عن قاعدة البيانات.
FIELD_ENCRYPTION_KEY=
