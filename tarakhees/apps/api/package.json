    "@nestjs/schedule": "^6.0.1",
    "@prisma/client": "^6.16.1",
    "@repo/shared": "*",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv-cli": "^10.0.0",
    "ioredis": "^5.11.1",
